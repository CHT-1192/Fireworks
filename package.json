{
  "name": "canvas-fireworks",
  "version": "1.0.0",
  "private": true,
  "description": "浏览器里的程序化烟花秀：单文件、零依赖、离线可玩（从 turtle_fireworks.py 移植来的维护版）",
  "keywords": [
    "fireworks",
    "canvas",
    "particle",
    "port"
  ],
  "license": "Apache-2.0",
  "author": "CHT-1192",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js --open",
    "build": "node build.js",
    "docs": "node tools/gen_docs.js",
    "check": "node build.js --check",
    "baseline": "node tools/baseline.js",
    "baseline:update": "node tools/baseline.js --update",
    "smoke": "node tools/render_smoke.js",
    "browser": "node tools/browser_check.js",
    "rng": "node tools/rng_check.js",
    "verify": "node build.js --check && node tools/render_smoke.js && node tools/baseline.js",
    "shot": "node tools/shot.js"
  },
  "devDependencies": {
    "playwright-core": "^1.63.0"
  }
}
