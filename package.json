{
  "name": "canvas-fireworks",
  "version": "1.0.0",
  "private": true,
  "description": "烟花 · Canvas 复刻版 —— turtle_fireworks.py 的浏览器移植（同 seed 逐位一致）",
  "keywords": [
    "fireworks",
    "canvas",
    "particle",
    "port"
  ],
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js --open",
    "build": "node build.js",
    "check": "node build.js --check",
    "baseline": "node tools/baseline.js",
    "baseline:update": "node tools/baseline.js --update",
    "smoke": "node tools/render_smoke.js",
    "verify": "node tools/verify.js",
    "verify:long": "node tools/verify.js --frames 400 --seeds 7,42,123456",
    "verify:render": "node tools/render_smoke.js && bash tools/render_check.sh"
  }
}
